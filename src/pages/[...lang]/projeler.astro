---
import Base from '../../layouts/Base.astro';
import { icerik, diller } from '../../data/site.js';
export const getStaticPaths = diller;
const { lang } = Astro.props;
const t = icerik[lang];
const s = t.projeSayfa;
---
<Base lang={lang} title={s.baslik} description={s.aciklama}>
  <section class="sayfa-bas">
    <div class="kap">
      <p class="ust-yazi">{s.baslik}</p>
      <h1>{s.baslik}</h1>
      <p class="giris">{s.giris}</p>
    </div>
  </section>

  <section class="bolum" style="padding-top:2rem">
    <ol class="kap liste">
      {t.projeler.map((p) => (
        <li>
          <span>{p.ad}</span>
          {p.url && <a href={p.url} target="_blank" rel="noopener" aria-label={t.ui.kaynakEtiket(p.ad)}>{t.ui.kaynak} ↗</a>}
        </li>
      ))}
    </ol>
  </section>
</Base>

<style>
  .liste { counter-reset: p; padding: 0; list-style: none; max-width: 60rem; }
  .liste li { counter-increment: p; display: grid; grid-template-columns: 3rem 1fr auto; gap: 1rem; align-items: center; padding: 1.15rem 0; border-bottom: 1px solid var(--cizgi); font-weight: 500; }
  .liste li::before { content: counter(p, decimal-leading-zero); font-weight: 700; color: #0b7a2a; font-variant-numeric: tabular-nums; }
  .liste a { font-size: 0.92rem; font-weight: 700; text-decoration: none; white-space: nowrap; padding: 0.6rem 0.9rem; border: 1px solid var(--cizgi); border-radius: 999px; background: #fff; }
  .liste a:hover { border-color: var(--canli); background: var(--acik); }
  @media (max-width: 600px) {
    .liste li { grid-template-columns: 2.2rem 1fr; }
    .liste a { grid-column: 2; justify-self: start; }
  }
</style>
