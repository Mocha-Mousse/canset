---
import { sirket, menu } from '../data/site.js';
const { title, description = 'Kurumsal sürdürülebilirlik danışmanlığı, karbon ayak izi, yaşam döngüsü değerlendirmesi ve çevresel etki raporlaması.' } = Astro.props;
const yol = decodeURI(Astro.url.pathname).replace(/\/$/, '');
---
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title ? `${title} | CANSET` : 'CANSET | Sürdürülebilirlik Danışmanlığı'}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/logo.webp" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <a class="atla" href="#icerik">İçeriğe geç</a>
  <header class="ust">
    <div class="kap ust-ic">
      <a href="/" class="logo" aria-label="CANSET ana sayfa"><img src="/logo.svg" alt="CANSET" width="137" height="60" /></a>
      <nav aria-label="Ana menü">
        <details class="mobil">
          <summary aria-label="Menü"><span></span></summary>
          <ul>
            {menu.map((m) => <li><a href={m.href} aria-current={yol === m.href ? 'page' : undefined}>{m.ad}</a></li>)}
            <li><a class="dugme" href="/iletisim">İletişim</a></li>
          </ul>
        </details>
      </nav>
    </div>
  </header>

  <main id="icerik"><slot /></main>

  <footer class="alt">
    <div class="kap alt-ic">
      <div>
        <p class="alt-ad">CANSET</p>
        <p>{sirket.ad}</p>
        <p>{sirket.adres}</p>
      </div>
      <div>
        <p class="alt-baslik">İletişim</p>
        <p><a href={`mailto:${sirket.eposta}`}>{sirket.eposta}</a></p>
        <p><a href={`tel:${sirket.tel}`}>{sirket.telGorunen}</a></p>
      </div>
      <div>
        <p class="alt-baslik">Site</p>
        <ul>
          {menu.map((m) => <li><a href={m.href}>{m.ad}</a></li>)}
          <li><a href="/iletisim">İletişim</a></li>
        </ul>
      </div>
    </div>
    <div class="kap telif">© {new Date().getFullYear()} CANSET. Tüm hakları saklıdır.</div>
  </footer>
</body>
</html>

<style is:global>
  :root {
    /* Logo renkleri: yazı #1A683C, filiz #009C2C */
    --koyu: #1a683c;
    --koyu-2: #124a2b;
    --canli: #009c2c;
    --acik: #eaf6ee;
    --zemin: #fbfdfb;
    --kart: #ffffff;
    --metin: #17231c;
    --soluk: #4d5f54;
    --cizgi: #dbe7df;
    --r: 14px;
  }
  *, *::before, *::after { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; font: 400 1.0625rem/1.65 'Plus Jakarta Sans', system-ui, sans-serif; color: var(--metin); background: var(--zemin); -webkit-font-smoothing: antialiased; }
  h1, h2, h3 { line-height: 1.15; letter-spacing: -0.02em; margin: 0 0 0.5em; text-wrap: balance; }
  h1 { font-size: clamp(2.2rem, 5.5vw, 3.9rem); font-weight: 800; }
  h2 { font-size: clamp(1.6rem, 3.2vw, 2.4rem); font-weight: 700; }
  h3 { font-size: 1.2rem; font-weight: 700; letter-spacing: -0.01em; }
  p { margin: 0 0 1em; }
  a { color: var(--koyu); text-underline-offset: 3px; }
  img { max-width: 100%; height: auto; }
  ul { padding: 0; margin: 0; list-style: none; }
  :focus-visible { outline: 3px solid var(--canli); outline-offset: 3px; border-radius: 4px; }

  .kap { width: min(1160px, 100% - 2.5rem); margin-inline: auto; }
  .dar { max-width: 46rem; }
  .bolum { padding: clamp(3.5rem, 8vw, 6.5rem) 0; }
  .bolum.tonlu { background: var(--acik); }
  .ust-yazi { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.14em; text-transform: uppercase; color: var(--canli); margin-bottom: 0.9rem; }
  /* canli yeşil beyaz üstünde küçük yazıda 4.5:1 vermez; üst yazı için koyulaştırılmış ton */
  .ust-yazi { color: #0b7a2a; }
  .giris { font-size: 1.2rem; color: var(--soluk); max-width: 44rem; }
  .sayfa-bas { padding: clamp(3rem, 7vw, 5.5rem) 0 clamp(2rem, 4vw, 3rem); background: linear-gradient(180deg, var(--acik), var(--zemin)); }
  .sayfa-bas h1 { font-size: clamp(2rem, 4.5vw, 3.2rem); }

  .atla { position: absolute; left: -999px; top: 0; background: var(--koyu); color: #fff; padding: 0.75rem 1rem; z-index: 100; }
  .atla:focus { left: 0; }

  .dugme { display: inline-flex; align-items: center; gap: 0.5rem; min-height: 46px; padding: 0.7rem 1.35rem; border-radius: 999px; background: var(--koyu); color: #fff; font-weight: 600; text-decoration: none; border: 2px solid var(--koyu); transition: background 0.2s, transform 0.2s; }
  .dugme:hover { background: var(--koyu-2); border-color: var(--koyu-2); transform: translateY(-1px); }
  .dugme.cizgili { background: transparent; color: var(--koyu); }
  .dugme.cizgili:hover { background: var(--acik); }
  .dugme-sira { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 1.75rem; }

  .ust { position: sticky; top: 0; z-index: 50; background: rgba(251, 253, 251, 0.9); backdrop-filter: blur(10px); border-bottom: 1px solid var(--cizgi); }
  .ust-ic { display: flex; align-items: center; justify-content: space-between; min-height: 72px; }
  .logo { display: flex; }
  .logo img { height: 56px; width: auto; }
  .mobil > summary { display: none; }
  .mobil ul { display: flex; align-items: center; gap: 0.25rem; }
  .mobil a:not(.dugme) { display: block; padding: 0.6rem 0.8rem; border-radius: 8px; color: var(--metin); text-decoration: none; font-weight: 500; font-size: 0.97rem; }
  .mobil a:not(.dugme):hover, .mobil a[aria-current] { color: var(--koyu); background: var(--acik); }
  .mobil .dugme { margin-left: 0.5rem; }
  @media (min-width: 901px) {
    /* masaüstünde details her zaman açık davranır */
    .mobil > ul { display: flex !important; }
    .mobil::details-content { content-visibility: visible; display: contents; }
  }
  @media (max-width: 900px) {
    .mobil > summary { display: grid; place-items: center; width: 46px; height: 46px; cursor: pointer; list-style: none; border-radius: 10px; }
    .mobil > summary::-webkit-details-marker { display: none; }
    .mobil > summary span, .mobil > summary span::before, .mobil > summary span::after { content: ''; display: block; width: 22px; height: 2px; background: var(--metin); border-radius: 2px; position: relative; }
    .mobil > summary span::before { position: absolute; top: -7px; }
    .mobil > summary span::after { position: absolute; top: 7px; }
    .mobil ul { position: absolute; left: 0; right: 0; top: 100%; flex-direction: column; align-items: stretch; gap: 0; padding: 0.75rem 1.25rem 1.25rem; background: var(--zemin); border-bottom: 1px solid var(--cizgi); box-shadow: 0 18px 30px -20px rgba(18, 74, 43, 0.4); }
    .mobil a:not(.dugme) { padding: 0.85rem 0.5rem; font-size: 1.05rem; }
    .mobil .dugme { margin: 0.75rem 0 0; justify-content: center; }
  }

  .izgara { display: grid; gap: 1.25rem; }
  .izgara.iki { grid-template-columns: repeat(auto-fit, minmax(min(100%, 26rem), 1fr)); }
  .izgara.uc { grid-template-columns: repeat(auto-fit, minmax(min(100%, 19rem), 1fr)); }
  .kart { background: var(--kart); border: 1px solid var(--cizgi); border-radius: var(--r); padding: 1.75rem; }
  .kart p:last-child { margin-bottom: 0; }
  .kart p { color: var(--soluk); font-size: 1rem; }
  .no { display: inline-grid; place-items: center; width: 2.4rem; height: 2.4rem; border-radius: 50%; background: var(--acik); color: var(--koyu); font-weight: 700; font-size: 0.95rem; margin-bottom: 1rem; }
  .rozet { display: inline-block; font-size: 0.75rem; font-weight: 700; letter-spacing: 0.04em; color: var(--koyu); background: var(--acik); border-radius: 999px; padding: 0.2rem 0.7rem; margin-bottom: 0.8rem; }

  .logolar { display: grid; grid-template-columns: repeat(auto-fill, minmax(140px, 1fr)); gap: 0.9rem; }
  .logolar a, .logolar span { display: grid; place-items: center; height: 104px; padding: 1rem; background: #fff; border: 1px solid var(--cizgi); border-radius: 12px; transition: border-color 0.2s, transform 0.2s; }
  .logolar a:hover { border-color: var(--canli); transform: translateY(-2px); }
  .logolar img { max-height: 64px; max-width: 100%; width: auto; object-fit: contain; }

  .cta { background: var(--koyu); color: #fff; border-radius: 24px; padding: clamp(2rem, 5vw, 3.5rem); display: flex; flex-wrap: wrap; gap: 1.5rem; align-items: center; justify-content: space-between; }
  .cta h2 { margin: 0 0 0.4rem; }
  .cta p { margin: 0; color: #cfe6d7; max-width: 36rem; }
  .cta .dugme { background: #fff; color: var(--koyu); border-color: #fff; }
  .cta .dugme:hover { background: var(--acik); }

  .alt { background: var(--koyu-2); color: #cfe6d7; margin-top: clamp(3rem, 7vw, 5rem); font-size: 0.97rem; }
  .alt a { color: #fff; text-decoration: none; }
  .alt a:hover { text-decoration: underline; }
  .alt-ic { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 2rem; padding: 3.5rem 0 2.5rem; }
  .alt-ic > div:first-child { max-width: 26rem; }
  .alt p { margin: 0 0 0.4rem; }
  .alt li { margin-bottom: 0.4rem; }
  .alt-ad { font-size: 1.5rem; font-weight: 800; color: #fff; letter-spacing: 0.04em; }
  .alt-baslik { font-weight: 700; color: #fff; margin-bottom: 0.8rem !important; }
  .telif { border-top: 1px solid rgba(255, 255, 255, 0.15); padding: 1.25rem 0; font-size: 0.87rem; }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
    * { transition: none !important; }
  }
</style>
